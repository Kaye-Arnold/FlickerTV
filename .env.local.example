# Flicker.TV — Environment Variables
# Copy this file to .env.local and fill in values.

# ────────────────────────────────────────────────────────────────────────────
# TMDB (The Movie Database) — optional enrichment layer
# Sign up free at https://www.themoviedb.org/settings/api
# Provides high-quality posters, backdrops, ratings, and cast data.
# If not set, Flicker.TV falls back to archive.org thumbnails.
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TMDB_READ_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# Analytics (optional) — self-hosted Plausible or Umami endpoint
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_URL=

# ────────────────────────────────────────────────────────────────────────────
# Feature flags — set to "true" to enable
# ────────────────────────────────────────────────────────────────────────────

# Force Turbo Mode globally (useful for bandwidth-constrained deployments)
NEXT_PUBLIC_FORCE_TURBO_MODE=false

# Enable the debug memory overlay in production builds
NEXT_PUBLIC_ENABLE_MEMORY_OVERLAY=false

# Maximum number of slides to keep in the virtual DOM at once
NEXT_PUBLIC_VIRTUAL_SLIDE_LIMIT=12